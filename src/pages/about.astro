---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const timeline = [
  { y: "2009", t: "Fundación",                   d: "SMR se establece como contratista especializado en refrigeración industrial." },
  { y: "2013", t: "Primera planta a escala MW",   d: "Pusimos en marcha nuestro primer sistema de amoniaco de múltiples megawatts." },
  { y: "2017", t: "División de controles inteligentes", d: "Lanzamos la práctica de monitoreo IoT e integración SCADA." },
  { y: "2020", t: "Cobertura nacional",           d: "Expandimos la red de servicio para cubrir cada estado de México." },
  { y: "2024", t: "+100 proyectos",               d: "Superamos 100 instalaciones llave en mano en 6 industrias." },
];
---

<BaseLayout
  title="Nosotros — SMR"
  description="Más de 15 años ingeniando refrigeración industrial e infraestructura de cadena de frío."
  canonical="/about"
  ogTitle="Nosotros — SMR"
  ogDescription="Nuestra misión, experiencia y equipo de ingeniería."
>
  <PageHero
    eyebrow="Sobre SMR"
    title="Infraestructura de frío, ingenierizada."
    subtitle="Diseñamos, construimos y operamos sistemas de refrigeración para industrias donde la temperatura no es negociable."
  />

  <!-- Misión & Experiencia -->
  <section class="py-24 bg-background">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-16">
      <div class="reveal">
        <h2 class="font-display text-3xl font-bold mb-5 text-foreground">Misión</h2>
        <p class="text-muted-foreground leading-relaxed text-lg">
          Entregar la infraestructura de cadena de frío más confiable, eficiente
          energéticamente e inteligente en América Latina — diseñada por especialistas,
          construida para durar décadas, y con soporte las 24 horas.
        </p>
      </div>
      <div class="reveal">
        <h2 class="font-display text-3xl font-bold mb-5 text-foreground">Experiencia</h2>
        <p class="text-muted-foreground leading-relaxed text-lg">
          Nuestro equipo combina ingeniería mecánica, eléctrica, de controles y
          energía bajo un mismo techo. Manejamos cada fase — desde el cálculo de
          carga térmica hasta la integración SCADA — sin subcontratar el trabajo crítico.
        </p>
      </div>
    </div>
  </section>

  <!-- Images -->
  <section class="py-24 bg-[oklch(0.95_0.01_240)]">
    <div class="mx-auto max-w-7xl px-6 grid lg:grid-cols-2 gap-12 items-center">
      <img src="/images/engineer.jpg" alt="Ingeniero SMR" loading="lazy" class="rounded-2xl border border-border reveal-scale" />
      <img src="/images/pipes.jpg" alt="Instalación SMR" loading="lazy" class="rounded-2xl border border-border reveal-scale" />
    </div>
  </section>

  <!-- Timeline -->
  <section class="py-24 bg-background">
    <div class="mx-auto max-w-7xl px-6">
      <p class="font-mono text-xs uppercase tracking-[0.3em] text-ice mb-4">Trayectoria</p>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-16 text-foreground">15 años de ingeniería del frío.</h2>

      <div class="relative pl-8 border-l border-border">
        {timeline.map((e) => (
          <div class="relative pb-12 reveal">
            <div class="absolute -left-[37px] top-1.5 h-3 w-3 rounded-full bg-ice shadow-glow"></div>
            <div class="font-mono text-sm text-ice">{e.y}</div>
            <h3 class="font-display text-2xl font-semibold mt-1">{e.t}</h3>
            <p class="text-muted-foreground mt-2 max-w-xl">{e.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
