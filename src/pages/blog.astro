---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
---

<BaseLayout
  title="Blog — SMR"
  description="Artículos, casos de estudio y recursos sobre ingeniería de refrigeración industrial."
  canonical="/blog"
  ogTitle="Blog — SMR"
  ogDescription="Insights de ingeniería de cadena de frío."
>
  <PageHero
    eyebrow="Blog"
    title="Insights de ingeniería del frío."
    subtitle="Artículos, casos de estudio y actualizaciones técnicas de nuestro equipo de ingeniería."
  />

  <section class="py-24">
    <div class="mx-auto max-w-7xl px-6">
      <div class="rounded-3xl border border-border bg-[oklch(0.97_0.01_240)] p-16 text-center">
        <div class="inline-flex h-14 w-14 items-center justify-center rounded-xl bg-ice/10 border border-ice/20 mb-6">
          <Icon name="sparkles" class="h-6 w-6 text-ice" />
        </div>
        <h2 class="font-display text-2xl font-bold mb-3">Próximamente</h2>
        <p class="text-muted-foreground max-w-md mx-auto">
          Estamos preparando contenido técnico sobre refrigeración industrial, eficiencia energética
          y mejores prácticas de cadena de frío.
        </p>
        <a href="/contact" class="mt-8 inline-flex items-center gap-2 px-6 py-3 rounded-md bg-gradient-ice text-white font-medium shadow-glow hover:opacity-90 transition">
          Contactar mientras tanto <Icon name="arrow-right" class="h-4 w-4" />
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
